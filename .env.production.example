# Variáveis de ambiente para produção (Coolify).
# Cadastre-as em Environment Variables, no recurso da aplicação.
# NÃO versione o arquivo preenchido.

# --- Obrigatória --------------------------------------------------------
# Senha do PostgreSQL. Gere uma forte (o Coolify tem um gerador no campo).
POSTGRES_PASSWORD=

# --- Opcionais (têm padrão) --------------------------------------------
# Tamanho máximo de cada PDF enviado, em MB. Se aumentar, ajuste também o
# client_max_body_size em nginx/nginx.conf.
MAX_UPLOAD_SIZE_MB=50

# Retenção dos .docx gerados, em dias.
FILE_RETENTION_DAYS=30

# Retenção dos PDFs de entrada, em horas.
UPLOAD_RETENTION_HOURS=24

# Scheduler de limpeza. Deixe true; só desative se rodar mais de uma réplica
# do backend, mantendo-o ativo em apenas uma delas.
ENABLE_SCHEDULER=true

# Origem liberada no CORS. O Coolify preenche automaticamente a partir do
# domínio do serviço; defina apenas se a API for consumida de outro domínio.
# FRONTEND_URL=https://notas.suaempresa.com.br
